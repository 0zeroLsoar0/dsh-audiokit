{
  "name": "@local/dsh-audio",
  "version": "0.5.10",
  "description": "Sound effects for HTML animation: a deterministic synthesizer exposed as DSH tools, plus the workflow skill that makes an agent actually use it.",
  "license": "MIT",
  "author": "Soar_L",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "test/*.mjs",
    "tools/*.mjs"
  ],
  "scripts": {
    "test": "node tools/test-all.mjs",
    "test:smoke": "node test/smoke.mjs",
    "pack:check": "node tools/test-all.mjs --only smoke && npm pack --dry-run"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "audio",
    "synthesizer",
    "sound-effects",
    "animation",
    "html"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0zeroLsoar0/dsh-audiokit.git"
  },
  "homepage": "https://github.com/0zeroLsoar0/dsh-audiokit#readme",
  "bugs": {
    "url": "https://github.com/0zeroLsoar0/dsh-audiokit/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
